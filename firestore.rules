rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isAdmin() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    match /apartments/{id} { allow read: if true; allow write: if false; }
    match /reviews/{id} { allow read: if true; allow write: if false; }
    match /users/{uid} { allow read: if request.auth.uid == uid || isAdmin(); allow write: if false; }
    match /bookings/{id} { allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin()); allow write: if false; }
    match /gallery/{id} { allow read: if true; allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
